<resources>
    <string name="app_name">Spoiler Blocker</string>

    <!-- Blocker list -->
    <string name="blockers_empty">No blockers yet.</string>
    <string name="blockers_new">New blocker</string>
    <string name="blockers_no_terms">No terms</string>
    <!-- What a tap on a row does. A screen reader says it after "Double tap to". -->
    <string name="blockers_row_action">edit</string>
    <!-- The button that opens the hidden list, without and with the number of entries. -->
    <string name="blockers_hidden">Hidden</string>
    <string name="blockers_hidden_count">Hidden (%1$d)</string>

    <!-- The card on the blocker list when a blocker is on without notification access -->
    <string name="access_card_title">Notifications are not being hidden</string>
    <string name="access_card_text">A blocker is on, but Spoiler Blocker is not allowed to see notifications. Allow notification access for it in the system settings.</string>
    <string name="access_card_button">Open settings</string>

    <!-- The card on the blocker list when a blocker is on and the app may not post notifications -->
    <string name="post_card_title">No reminder that a blocker is on</string>
    <string name="post_card_text">Spoiler Blocker shows a notification while a blocker is on, so that the blocker is not forgotten. It is not allowed to show notifications. Allow them in the system settings.</string>
    <string name="post_card_button">Open settings</string>

    <!-- The status notification. Its channel is what the system settings list for this app. -->
    <string name="status_channel_name">Blocking status</string>
    <string name="status_channel_description">Shows while a blocker is on.</string>
    <plurals name="status_title">
        <item quantity="one">%1$d blocker is on</item>
        <item quantity="other">%1$d blockers are on</item>
    </plurals>
    <!--
        The names of the first blockers, then how many more are on: "Cup final, Season finale and 2 more".
        English uses the same words for one and for several. Other languages do not.
    -->
    <plurals name="status_names_and_more">
        <item quantity="one">%1$s and %2$d more</item>
        <item quantity="other">%1$s and %2$d more</item>
    </plurals>
    <string name="status_no_access_title">Notifications are not being hidden</string>
    <!-- Only the first line shows until the notification is expanded. %1$s is the names of the blockers that are on. -->
    <string name="status_no_access_text">Notification access is off. Tap to fix this.\nOn: %1$s</string>

    <!-- Hidden list -->
    <string name="hidden_title">Hidden while blocking</string>
    <string name="hidden_back">Back</string>
    <string name="hidden_empty">Nothing has been hidden.</string>
    <!-- The app and the time of one entry, for example "Messages · 5 Oct, 14:32". -->
    <string name="hidden_app_and_time">%1$s · %2$s</string>
    <string name="hidden_concealed">Tap to show</string>
    <string name="hidden_by">Hidden by %1$s</string>
    <!--
        The blocker's name, then what was found: one term, one source, or
        several weak terms with commas between them. That is why it follows a
        colon and is not put in quotation marks: “Max, podium” in quotation
        marks would say that those words were found exactly like that.
    -->
    <string name="hidden_reason_term">Hidden by %1$s. It contains: %2$s</string>
    <string name="hidden_reason_group">Hidden by %1$s. It was in a group whose summary contains: %2$s</string>
    <!-- For example "Open Messages". -->
    <string name="hidden_open_app">Open %1$s</string>
    <!-- What a tap on a row does. A screen reader says it after "Double tap to". -->
    <string name="hidden_row_reveal">show</string>
    <string name="hidden_row_conceal">hide</string>
    <string name="hidden_reveal_all">Show all</string>
    <string name="hidden_conceal_all">Hide all</string>
    <string name="hidden_clear_all">Clear all</string>
    <string name="hidden_clear_title">Clear the hidden list?</string>
    <string name="hidden_clear_text">Every entry is removed from this list. This cannot be undone.</string>
    <string name="hidden_clear_confirm">Clear</string>
    <string name="hidden_clear_cancel">Cancel</string>

    <!-- Blocker editor -->
    <string name="editor_title_new">New blocker</string>
    <string name="editor_title_edit">Edit blocker</string>
    <string name="editor_back">Back</string>
    <string name="editor_save">Save</string>
    <string name="editor_delete">Delete</string>
    <string name="editor_name">Name</string>
    <!-- Not "On": a screen reader says the state first, and "Off, On, switch" makes no sense. -->
    <string name="editor_enabled">Blocking</string>
    <string name="editor_terms_empty">No terms or sources yet, so this blocker hides nothing.</string>
    <!--
        The three lists. Each title ends with how many entries the list has.
        The line under it says what the list does. "Matching rules" in
        docs/ARCHITECTURE.md is where those rules are written down.
    -->
    <string name="editor_strong_title">Strong terms (%1$d)</string>
    <string name="editor_strong_helper">Any one of these is enough to hide something.</string>
    <string name="editor_weak_title">Weak terms (%1$d)</string>
    <string name="editor_weak_helper_narrow">Words that often mean something else. It takes two different ones together to hide something.</string>
    <string name="editor_weak_helper_broad">Words that often mean something else. One is enough to hide something, because the breadth is broad.</string>
    <string name="editor_sources_title">Sources (%1$d)</string>
    <string name="editor_sources_helper">Channel, account and app names. Anything that comes from one of them is hidden.</string>
    <string name="editor_term_field">Word or phrase</string>
    <string name="editor_source_field">Channel, account or app</string>
    <string name="editor_term_add">Add</string>
    <string name="editor_term_refused">Not added: it has no letter or digit, so it could never be found.</string>
    <!-- The menu that a tap on a term opens. -->
    <string name="editor_term_to_weak">Move to weak terms</string>
    <string name="editor_term_to_strong">Move to strong terms</string>
    <string name="editor_term_remove">Remove</string>
    <!-- Under a long list, which shows only its first entries. %1$d is how many it has. -->
    <string name="editor_terms_show_all">Show all %1$d</string>
    <string name="editor_terms_show_fewer">Show fewer</string>
    <string name="editor_delete_title">Delete this blocker?</string>
    <string name="editor_delete_text">This cannot be undone.</string>
    <string name="editor_delete_cancel">Cancel</string>
    <!-- Asked on Back when a new blocker has terms that were never saved. -->
    <string name="editor_discard_title">Discard this blocker?</string>
    <string name="editor_discard_text">It has not been saved. Suggested terms would have to be asked for again.</string>
    <string name="editor_discard_confirm">Discard</string>
    <string name="editor_discard_cancel">Keep editing</string>

    <!-- The first step of a new blocker: describing it -->
    <string name="describe_intro">Say what you do not want spoiled. Claude can suggest the terms to block, and you check them before anything is saved.</string>
    <string name="describe_field">Description</string>
    <string name="describe_example">For example: 2026 Japanese Grand Prix</string>
    <string name="describe_what_is_sent">Suggesting sends this description, the breadth and today\'s date to the Claude API, and nothing else.</string>
    <string name="describe_suggest">Suggest terms</string>
    <string name="describe_type_myself">Type them myself</string>
    <string name="describe_working">Asking Claude for terms. This can take a few minutes, because it searches the web first. Going back cancels the request.</string>
    <string name="describe_cancel">Cancel</string>
    <string name="describe_try_again">Try again</string>
    <!-- Small print under a failure sentence. %1$s is the cause, in English, as the code reports it. -->
    <string name="describe_failure_detail">Detail: %1$s</string>
    <!--
        One sentence for each way that asking for terms can fail. "Try again"
        is offered with the ones where the same request may work next time.
    -->
    <string name="suggest_failed_missing_key">This build of the app has no Anthropic API key, so it cannot ask for terms. Put the line anthropic.apiKey=… in the file local.properties at the top of the repository, then build and install the app again.</string>
    <string name="suggest_failed_no_network">Could not reach the Claude API. Check the connection, then try again.</string>
    <string name="suggest_failed_timeout">The Claude API did not answer in time. Try again.</string>
    <string name="suggest_failed_auth">The Claude API did not accept the API key. Check the line anthropic.apiKey=… in local.properties, then build and install the app again.</string>
    <string name="suggest_failed_rate_limited">The Claude API is turning requests away for now. Wait a minute, then try again. If it keeps happening, the account may have reached its spending limit.</string>
    <string name="suggest_failed_server_error">The Claude API is overloaded or failed on its side. Try again in a moment.</string>
    <string name="suggest_failed_http_other">The Claude API turned the request down. This is usually about the account, such as no credit left. The detail below says more.</string>
    <string name="suggest_failed_refused">Claude declined to suggest terms for this description. Change the description, or type the terms yourself.</string>
    <string name="suggest_failed_bad_reply">The answer could not be used: it was cut short, or it was not the three lists. Try again.</string>
    <string name="suggest_failed_nothing_found">No terms came back for this description. Make it more specific, or type the terms yourself.</string>

    <!-- The choice between a narrow and a broad blocker -->
    <string name="breadth_title">Breadth</string>
    <string name="breadth_narrow">Narrow</string>
    <string name="breadth_narrow_explanation">One event, such as a single race.</string>
    <string name="breadth_broad">Broad</string>
    <string name="breadth_broad_explanation">A whole subject, such as all of a sport or a series.</string>
</resources>
