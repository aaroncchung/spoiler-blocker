<resources>
    <string name="app_name">Spoiler Blocker</string>

    <!-- Blocker list -->
    <string name="blockers_empty">No blockers yet.</string>
    <string name="blockers_new">New blocker</string>
    <string name="blockers_no_terms">No terms</string>
    <!-- What a tap on a row does. A screen reader says it after "Double tap to". -->
    <string name="blockers_row_action">edit</string>
    <!-- The button that opens the hidden list, without and with the number of entries. -->
    <string name="blockers_hidden">Hidden</string>
    <string name="blockers_hidden_count">Hidden (%1$d)</string>

    <!-- The card on the blocker list when a blocker is on without notification access -->
    <string name="access_card_title">Notifications are not being hidden</string>
    <string name="access_card_text">A blocker is on, but Spoiler Blocker is not allowed to see notifications. Allow notification access for it in the system settings.</string>
    <string name="access_card_button">Open settings</string>

    <!-- The status notification. Its channel is what the system settings list for this app. -->
    <string name="status_channel_name">Blocking status</string>
    <string name="status_channel_description">Shows while a blocker is on.</string>
    <plurals name="status_title">
        <item quantity="one">%1$d blocker is on</item>
        <item quantity="other">%1$d blockers are on</item>
    </plurals>
    <!--
        The names of the first blockers, then how many more are on: "Cup final, Season finale and 2 more".
        English uses the same words for one and for several. Other languages do not.
    -->
    <plurals name="status_names_and_more">
        <item quantity="one">%1$s and %2$d more</item>
        <item quantity="other">%1$s and %2$d more</item>
    </plurals>
    <string name="status_no_access_title">Notifications are not being hidden</string>
    <!-- Only the first line shows until the notification is expanded. %1$s is the names of the blockers that are on. -->
    <string name="status_no_access_text">Notification access is off. Tap to fix this.\nOn: %1$s</string>

    <!-- Hidden list -->
    <string name="hidden_title">Hidden while blocking</string>
    <string name="hidden_back">Back</string>
    <string name="hidden_empty">Nothing has been hidden.</string>
    <!-- The app and the time of one entry, for example "Messages · 5 Oct, 14:32". -->
    <string name="hidden_app_and_time">%1$s · %2$s</string>
    <string name="hidden_concealed">Tap to show</string>
    <string name="hidden_by">Hidden by %1$s</string>
    <!-- The blocker's name, then the term that was found. -->
    <string name="hidden_reason_term">Hidden by %1$s. It contains “%2$s”.</string>
    <string name="hidden_reason_group">Hidden by %1$s. It was in a group whose summary contains “%2$s”.</string>
    <!-- For example "Open Messages". -->
    <string name="hidden_open_app">Open %1$s</string>
    <!-- What a tap on a row does. A screen reader says it after "Double tap to". -->
    <string name="hidden_row_reveal">show</string>
    <string name="hidden_row_conceal">hide</string>
    <string name="hidden_reveal_all">Show all</string>
    <string name="hidden_conceal_all">Hide all</string>
    <string name="hidden_clear_all">Clear all</string>
    <string name="hidden_clear_title">Clear the hidden list?</string>
    <string name="hidden_clear_text">Every entry is removed from this list. This cannot be undone.</string>
    <string name="hidden_clear_confirm">Clear</string>
    <string name="hidden_clear_cancel">Cancel</string>

    <!-- Blocker editor -->
    <string name="editor_title_new">New blocker</string>
    <string name="editor_title_edit">Edit blocker</string>
    <string name="editor_back">Back</string>
    <string name="editor_save">Save</string>
    <string name="editor_delete">Delete</string>
    <string name="editor_name">Name</string>
    <!-- Not "On": a screen reader says the state first, and "Off, On, switch" makes no sense. -->
    <string name="editor_enabled">Blocking</string>
    <string name="editor_terms_title">Terms</string>
    <string name="editor_term_field">Word or phrase</string>
    <string name="editor_term_add">Add</string>
    <string name="editor_terms_helper">Anything containing one of these words or phrases is hidden.</string>
    <string name="editor_terms_empty">No terms yet, so this blocker hides nothing.</string>
    <!-- Read out by a screen reader for the chip of one term, for example "Remove Suzuka". -->
    <string name="editor_term_remove">Remove %1$s</string>
    <string name="editor_delete_title">Delete this blocker?</string>
    <string name="editor_delete_text">This cannot be undone.</string>
    <string name="editor_delete_cancel">Cancel</string>
</resources>
