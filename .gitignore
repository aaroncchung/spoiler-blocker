# Secrets and machine-specific config
local.properties
*.keystore
*.jks
.env

# Real captures from a phone (screen text, notifications). Never commit these.
captures/
*.capture.json

# Real labelled examples for the evaluation script. Never commit these.
# Every examples file is ignored wherever it is saved, except the invented
# samples in eval/sample/.
eval/data/
*.jsonl
!eval/sample/*.jsonl

# Model weights
*.onnx
*.gguf
*.tflite
*.litertlm
*.safetensors

# Android / Gradle build output
.gradle/
build/
*.apk
*.aab

# IDE
.idea/
*.iml
.DS_Store

# Kotlin compiler session files
.kotlin/
